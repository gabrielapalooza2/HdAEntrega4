      ]
    },
    {
      "name": "Consultas sueltas",
      "item": [
        {
          "name": "GET Asignación por trabajo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('tiene asignacion_id', () => pm.expect(b.asignacion_id).to.be.ok);",
                  "pm.test('origen proyección local', () => pm.expect(b.origen_habilitacion).to.eql('PROYECCION_LOCAL'));",
                  "pm.test('estado ASIGNADO o RECHAZADO', () => pm.expect(b.estado).to.be.oneOf(['ASIGNADO', 'RECHAZADO']));"
                ]
              }
            }
          ],
          "request": {
